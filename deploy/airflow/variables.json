{
  "etl_config": {
    "schedule": "0 2 * * *",
    "qdrant_url": "http://qdrant:6333",
    "qdrant_secret_name": "qdrant-secrets",
    "pvc_name": "pvc-data",
    "mount_path": "/app/data",
    "resources": {
      "requests": {"cpu": "2", "memory": "4Gi"},
      "limits": {"cpu": "4", "memory": "8Gi"}
    },
    "default_args": {
      "owner": "ml_team",
      "retries": 2,
      "retry_delay_minutes": 3
    }
  },

  "analytics_config": {
  "schedule": "0 8 * * *",
  "db_connection": "postgresql://user:pass@db_host:5432/analytics",
  "resources": {
    "requests": {"cpu": "2", "memory": "4Gi"},
    "limits": {"cpu": "4", "memory": "8Gi"}
    }
  },

  "evaluation_config": {
  "schedule": "@weekly",
  "drift_threshold": 0.9,
  "resources": {
    "requests": {"cpu": "2", "memory": "8Gi"},
    "limits": {"cpu": "4", "memory": "16Gi", "nvidia.com/gpu": "1"}
    }
  },

  "maintenance_config": {
  "schedule": "0 3 * * 0",
  "s3_bucket": "my-company-backups/qdrant",
  "retention_days": 30
  },

  "training_config": {
    "schedule": "@weekly",
    "pvc_name": "pvc-models",
    "mount_path": "/app/models",
    "resources": {
      "requests": {"cpu": "4", "memory": "16Gi"},
      "limits": {
        "cpu": "8",
        "memory": "32Gi",
        "nvidia.com/gpu": "1"
      }
    },
    "default_args": {
      "owner": "ml_team",
      "retries": 1,
      "retry_delay_minutes": 5
    }
  }
}